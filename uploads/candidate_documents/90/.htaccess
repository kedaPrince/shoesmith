# Apache 2.4 - Simple and working
# Allow access to all files
Require all granted

# Prevent directory listing
Options -Indexes

# Block PHP/executable files for security
<FilesMatch "\.(php|phtml|php[0-9]|inc|exe|dll|bat|cmd)$">
    Require all denied
</FilesMatch>

# Set cache headers (optional)
<IfModule mod_headers.c>
    <FilesMatch "\.(pdf|jpg|jpeg|png|gif|doc|docx)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>